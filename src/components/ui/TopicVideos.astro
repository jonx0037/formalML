---
import { toVideoIds, type VideoIdField } from '../../lib/videoIds';

interface Props {
  videoId?: VideoIdField;
  title: string;
}

const { videoId, title } = Astro.props;
const videoIds = toVideoIds(videoId);
---

{videoIds.length > 0 && (
  <section class="mb-12 space-y-6" aria-label="Video lectures">
    {videoIds.map((id, index) => (
      <div>
        {videoIds.length > 1 && (
          <p class="mb-2 text-sm font-semibold" style="color: var(--color-text-secondary);">Part {index + 1}</p>
        )}
        <div class="aspect-video overflow-hidden rounded-lg">
          <iframe
            src={`https://www.youtube.com/embed/${id}`}
            title={videoIds.length > 1 ? `${title}, Part ${index + 1}` : title}
            class="h-full w-full"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </div>
    ))}
  </section>
)}
