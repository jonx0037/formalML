---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { renderInlineMath } from '../../lib/renderInlineMath';

interface Props {
  src: ImageMetadata | string;
  /** Plain text (an HTML attribute) — `$…$` is NOT rendered here; describe the math in words. */
  alt: string;
  /** May contain `$…$` inline TeX, rendered with KaTeX at build time like MDX math. `\$` is a literal dollar. */
  caption?: string;
  /** Override the auto-generated srcset widths. Only applies to imported assets. */
  widths?: number[];
  /** Override the sizes attribute. Default matches TopicLayout's max-w-3xl with lg:px-8 (768 - 64 = 704px inner). */
  sizes?: string;
  /** Reserve layout space when using a string src (public/ path). Ignored for imported assets (dimensions are inferred). */
  aspectRatio?: string;
}

const {
  src,
  alt,
  caption,
  widths = [400, 600, 800, 1200],
  sizes = '(max-width: 640px) calc(100vw - 2rem), 704px',
  aspectRatio,
} = Astro.props;

const isImportedAsset = typeof src !== 'string';
---

<figure>
  {isImportedAsset ? (
    <Image
      src={src}
      alt={alt}
      layout="constrained"
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      style={aspectRatio ? `aspect-ratio: ${aspectRatio}; object-fit: contain;` : undefined}
    />
  )}
  {caption && <figcaption set:html={renderInlineMath(caption)} />}
</figure>
